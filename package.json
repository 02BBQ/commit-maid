{
  "name": "commit-maid",
  "displayName": "commit-maid",
  "description": "help me maid",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:commit-maid.helloWorld"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Commit Maid",
      "properties": {
        "commitMaid.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "Your OpenAI API key"
        },
        "commitMaid.model": {
          "type": "string",
          "default": "gpt-3.5-turbo",
          "description": "GPT model to use (e.g., gpt-3.5-turbo, gpt-4)"
        },
        "commitMaid.groqApiKey": {
          "type": "string",
          "default": "",
          "description": "Groq Cloud API Key"
        },
        "commitMaid.groqModel": {
          "type": "string",
          "default": "mixtral-8x7b-32768",
          "description": "Groq model (mixtral-8x7b-32768 or llama3-70b-8192)",
          "enum": [
            "mixtral-8x7b-32768",
            "llama3-70b-8192"
          ]
        }
      }
    },
    "commands": [
      {
        "command": "commit-maid.helloWorld",
        "title": "Hello World",
        "category": "Commit Maid"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "groq-sdk": "^0.22.0",
    "node-fetch": "^2.7.0",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/02BBQ/commit-maid"
  }
}
